{
  "name": "autoreview",
  "private": true,
  "description": "Two Copilot CLI agents deliberate a pull request: one reviews, one fixes and replies.",
  "bin": {
    "autoreview": "src/autoreview.ts"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
